+
+    // Check RS-v1 now has revision=3 with history=["1"]
+    let owned_rs = get_owned_replicasets(&store, "test-rollback").await?;
+    let current_rs: Vec<_> = owned_rs.iter().filter(|rs| get_rs_revision(rs) == 3).collect();
